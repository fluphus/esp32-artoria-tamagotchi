new file mode 100644
index 0000000..9c7cc30
--- /dev/null
+++ b/src/core/save_io.cpp
@@ -0,0 +1,30 @@
+#include "save_io.h"
+#include <stdio.h>
+#include <stdarg.h>
+#ifdef ARDUINO
+#include <Arduino.h>
+#include <Preferences.h>
+namespace {Preferences preferences;}
+#endif
+namespace saveio {
+#ifdef ARDUINO
+Storage storage{&preferences,
+ [](void*p,const char*n,bool ro){return static_cast<Preferences*>(p)->begin(n,ro);},
+ [](void*p,const char*k){return static_cast<Preferences*>(p)->isKey(k);},
+ [](void*p,const char*k){return static_cast<Preferences*>(p)->getBytesLength(k);},
+ [](void*p,const char*k,void*b,size_t n){return static_cast<Preferences*>(p)->getBytes(k,b,n);},
+ [](void*p,const char*k,const void*b,size_t n){return static_cast<Preferences*>(p)->putBytes(k,b,n);},
+ [](void*p){return static_cast<Preferences*>(p)->clear();}};
+void (*diagnostic)(const char*)=[](const char*s){Serial.print(s);};
+#else
+Storage storage;
+void (*diagnostic)(const char*)=nullptr;
+#endif
+Log log;
+void Log::println(const char*s) const {if(diagnostic){diagnostic(s);diagnostic("\n");}}
+void Log::printf(const char*fmt,...) const {
+    char buffer[256];va_list args;va_start(args,fmt);
+    vsnprintf(buffer,sizeof(buffer),fmt,args);va_end(args);
+    if(diagnostic)diagnostic(buffer);
+}
+}
diff --git a/src/core/save_io.h b/src/core/save_io.h
new file mode 100644
index 0000000..0bf7f93
--- /dev/null
+++ b/src/core/save_io.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+// Only storage/logging needed by the original v9 save code. No game engine.
+namespace saveio {
+struct Storage {
+    void* context=nullptr;
+    bool (*open)(void*,const char*,bool)=nullptr;
+    bool (*contains)(void*,const char*)=nullptr;
+    size_t (*length)(void*,const char*)=nullptr;
+    size_t (*read)(void*,const char*,void*,size_t)=nullptr;
+    size_t (*write)(void*,const char*,const void*,size_t)=nullptr;
+    bool (*eraseAll)(void*)=nullptr;
+    bool begin(const char*n,bool ro){return open&&open(context,n,ro);}
+    bool isKey(const char*k){return contains&&contains(context,k);}
+    size_t getBytesLength(const char*k){return length?length(context,k):0;}
+    size_t getBytes(const char*k,void*b,size_t n){return read?read(context,k,b,n):0;}
+    size_t putBytes(const char*k,const void*b,size_t n){return write?write(context,k,b,n):0;}
+    bool clear(){return eraseAll&&eraseAll(context);}
+};
+extern Storage storage;
+extern void (*diagnostic)(const char*);
+struct Log {void println(const char*) const;void printf(const char*,...) const;};
+extern Log log;
+}
